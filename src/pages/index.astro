---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Proof from "../components/Proof.astro";
import Services from "../components/Services.astro";
import Stack from "../components/Stack.astro";
import Cases from "../components/Cases.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Testimonials from "../components/Testimonials.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
	<Header />

	<main id="contenido">
		<Hero />
		<Proof />
		<Services />
		<Stack />
		<Cases />
		<About />
		<Experience />
		<Education />
		<Testimonials />
		<Faq />
		<Contact />
	</main>

	<Footer />
</Layout>

{/* La entrada por scroll se configura en Layout.astro, junto a la clase que
    la habilita, para que ocultar y revelar no puedan separarse. */}
