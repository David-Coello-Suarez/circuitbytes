---
import { process } from "../data/content";
---

<section id="proceso">
	<div class="wrap">
		<div class="section-head">
			<h2>Cómo trabajamos</h2>
			<p>
				Cinco etapas, sin sorpresas entre una y otra. Sabes qué se entrega en
				cada punto antes de empezar.
			</p>
		</div>

		<ol class="steps">
			{
				process.map((step, index) => (
					<li class="rise">
						<span class="num tabular">{String(index + 1).padStart(2, "0")}</span>
						<div>
							<h3>{step.title}</h3>
							<p>{step.description}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	section {
		padding-block: 5rem;
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: step;
		border-top: 1px solid var(--color-rule);
	}

	.steps > li {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: 1.5rem;
		align-items: baseline;
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--color-rule);
	}

	/* la numeración sí lleva información: es una secuencia */
	.num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-ink-soft);
	}

	h3 {
		font-size: 1.05rem;
		margin: 0 0 0.35rem;
	}

	p {
		margin: 0;
		color: var(--color-ink-soft);
		font-size: 0.9375rem;
		max-width: 62ch;
	}

	@media (max-width: 640px) {
		.steps > li {
			grid-template-columns: 2.5rem minmax(0, 1fr);
			gap: 1rem;
		}
	}
</style>
