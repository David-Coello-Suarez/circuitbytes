---
import { Icon } from "astro-icon/components";
import { profile } from "../data/profile";
---

<section id="contacto">
	<div class="wrap">
		<div class="grid">
			<div>
				<h2>Hablemos de tu proyecto</h2>
				<p class="lead">
					Cuéntame qué necesitas construir o qué sistema te está dando
					problemas. Respondo en menos de 24 horas hábiles.
				</p>
			</div>

			<ul class="channels">
				<li>
					<a href={`mailto:${profile.email}`}>
						<Icon name="ph:envelope-simple-bold" aria-hidden="true" />
						<span>
							<span class="label">Email</span>
							{profile.email}
						</span>
					</a>
				</li>
				<li>
					<a href={profile.whatsappHref}>
						<Icon name="ph:whatsapp-logo-bold" aria-hidden="true" />
						<span>
							<span class="label">WhatsApp</span>
							{profile.phones[0]}
						</span>
					</a>
				</li>
				<li>
					<a href={profile.phonePrimaryHref}>
						<Icon name="ph:phone-bold" aria-hidden="true" />
						<span>
							<span class="label">Teléfono</span>
							{profile.phones.join(" / ")}
						</span>
					</a>
				</li>
				<li>
					<p>
						<Icon name="ph:map-pin-bold" aria-hidden="true" />
						<span>
							<span class="label">Ubicación</span>
							{profile.location}
						</span>
					</p>
				</li>
			</ul>
		</div>

		<a class="btn btn-primary big" href={`mailto:${profile.email}`}>
			Escribir un correo
		</a>
	</div>
</section>

<style>
	section {
		padding-block: 5rem 6rem;
		border-top: 1px solid var(--color-line);
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
		gap: 3rem;
		align-items: start;
	}

	h2 {
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		max-width: 14ch;
		margin: 0 0 1rem;
	}

	.lead {
		color: var(--color-ink-muted);
		max-width: 46ch;
		margin: 0;
	}

	.channels {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-line);
	}

	.channels li {
		border-bottom: 1px solid var(--color-line);
	}

	.channels a,
	.channels p {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding-block: 1rem;
		margin: 0;
		font-size: 0.95rem;
		text-decoration: none;
		transition: color 180ms var(--ease-out);
	}

	.channels a:hover {
		color: var(--color-accent);
	}

	.channels [data-icon] {
		width: 1.15rem;
		height: 1.15rem;
		color: var(--color-ink-muted);
		flex-shrink: 0;
	}

	.channels a:hover [data-icon] {
		color: var(--color-accent);
	}

	.label {
		display: block;
		font-size: 0.75rem;
		color: var(--color-ink-muted);
		margin-bottom: 0.1rem;
	}

	.big {
		margin-top: 3rem;
		padding: 0.9rem 1.75rem;
		font-size: 1rem;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
