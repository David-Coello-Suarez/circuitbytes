---
import { faq } from "../data/content";
---

<section id="faq">
	<div class="wrap grid">
		<h2>Preguntas frecuentes</h2>

		<div class="list">
			{
				faq.map((item, index) => (
					<details open={index === 0} name="faq">
						<summary>
							{item.question}
							<span class="sign" aria-hidden="true" />
						</summary>
						<p>{item.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	section {
		padding-block: 5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
		gap: 2rem 4rem;
		align-items: start;
	}

	h2 {
		font-size: clamp(1.9rem, 4vw, 2.75rem);
		margin: 0;
	}

	/* sin cajas: los items se separan solo con un filete */
	.list {
		border-top: 1px solid var(--color-rule);
	}

	details {
		border-bottom: 1px solid var(--color-rule);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1.125rem;
		cursor: pointer;
		list-style: none;
		font-size: 1rem;
		font-weight: 500;
		color: var(--color-ink-strong);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	/* signo + / - dibujado con dos trazos */
	.sign {
		position: relative;
		width: 11px;
		height: 11px;
		flex-shrink: 0;
	}

	.sign::before,
	.sign::after {
		content: "";
		position: absolute;
		background: var(--color-ink-strong);
		transition: transform 200ms var(--ease-out);
	}

	.sign::before {
		left: 0;
		top: 50%;
		width: 11px;
		height: 1.5px;
		transform: translateY(-50%);
	}

	.sign::after {
		left: 50%;
		top: 0;
		width: 1.5px;
		height: 11px;
		transform: translateX(-50%);
	}

	details[open] .sign::after {
		transform: translateX(-50%) scaleY(0);
	}

	details p {
		margin: 0;
		padding-bottom: 1.375rem;
		color: var(--color-ink-soft);
		font-size: 0.9375rem;
		max-width: 68ch;
	}

	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
