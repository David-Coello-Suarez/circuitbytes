---
import { faq } from "../data/faq";
---

<section id="faq">
	<div class="wrap">
		<div class="head">
			<span class="mono">FAQ</span>
			<h2>Preguntas frecuentes</h2>
		</div>

		<div class="faq">
			{
				faq.map((item, index) => (
					<details open={index === 0} name="faq">
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq {
		max-width: 780px;
	}

	details {
		border: 1px solid var(--border);
		border-radius: 11px;
		background: var(--surface);
		margin-bottom: 12px;
	}

	summary {
		cursor: pointer;
		padding: 19px 22px;
		font-weight: 500;
		list-style: none;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		align-items: center;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: "+";
		color: var(--accent);
		font-size: 1.3rem;
		line-height: 1;
		flex-shrink: 0;
	}

	details[open] summary::after {
		content: "−";
	}

	details p {
		padding: 0 22px 22px;
		color: var(--muted);
		font-size: 0.93rem;
	}
</style>
