---
import { testimonials } from "../data/testimonials";
---

<section id="testimonios">
	<div class="wrap">
		<div class="head">
			<span class="mono">Testimonios</span>
			<h2>Lo que dicen nuestros clientes</h2>
		</div>

		<div class="grid-3">
			{
				testimonials.map((testimonial) => (
					<figure class="tcard">
						<blockquote>“{testimonial.quote}”</blockquote>
						<figcaption class="who">
							<span class="avatar" aria-hidden="true">
								{testimonial.initials}
							</span>
							<span>
								<b>{testimonial.author}</b>
								<span class="role">{testimonial.role}</span>
							</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>

<style>
	.tcard {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 28px;
		margin: 0;
	}

	blockquote {
		margin: 0 0 22px;
		font-size: 0.97rem;
	}

	.who {
		display: flex;
		align-items: center;
		gap: 13px;
	}

	.avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		flex-shrink: 0;
		display: grid;
		place-items: center;
		background: rgba(34, 211, 238, 0.12);
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 600;
		border: 1px solid var(--border);
	}

	.who b {
		display: block;
		font-size: 0.88rem;
		font-weight: 500;
	}

	.role {
		font-size: 0.78rem;
		color: var(--muted);
	}
</style>
