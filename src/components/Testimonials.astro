---
import { profile } from "../data/profile";

/**
 * No hay testimonios autorizados todavía, así que no se inventa ninguno:
 * se remite a LinkedIn, como indica el brief.
 *
 * TODO: cuando haya citas reales con permiso del cliente, sustituir este
 * bloque por las recomendaciones (cita, nombre, cargo y empresa).
 */
---

<section id="referencias">
	<div class="wrap">
		<div class="panel">
			<h2>Referencias</h2>
			<p>
				Las recomendaciones de clientes y colegas están publicadas en mi perfil
				de LinkedIn. Si necesitas hablar con alguna referencia directa antes de
				contratar, te la facilito sin problema.
			</p>
			<a class="btn btn-ghost" href={profile.linkedin}>
				Ver recomendaciones en LinkedIn
			</a>
		</div>
	</div>
</section>

<style>
	section {
		padding-block: 5rem;
	}

	.panel {
		padding: 3rem;
		display: grid;
		justify-items: start;
		gap: 1rem;
	}

	h2 {
		font-size: clamp(1.5rem, 3vw, 1.9rem);
		margin: 0;
	}

	p {
		color: var(--color-ink-muted);
		max-width: 60ch;
		margin: 0;
	}

	.btn {
		margin-top: 0.75rem;
	}

	@media (max-width: 640px) {
		.panel {
			padding: 2rem 1.5rem;
		}
	}
</style>
