---
import { projects } from "../data/projects";
---

<section id="proyectos">
	<div class="wrap">
		<div class="head">
			<h2>Trabajo reciente</h2>
			<p>Una muestra de lo que hemos construido en los últimos años.</p>
		</div>

		{/*
			TODO: cuando haya capturas reales de cada proyecto, añadir
			<img> con width/height y aspect-ratio 16/10 sobre el título.
			No se usa un marcador decorativo: una miniatura inventada
			promete un material que no existe.
		*/}
		<ol class="projects">
			{
				projects.map((project) => (
					<li>
						<a href={project.href}>
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							<ul class="tags">
								{project.tags.map((tag) => (
									<li class="tag">{tag}</li>
								))}
							</ul>
						</a>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.projects {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border-strong);
	}

	.projects li {
		border-bottom: 1px solid var(--border);
	}

	.projects a {
		display: grid;
		grid-template-columns: minmax(0, 20ch) minmax(0, 1fr) auto;
		align-items: baseline;
		gap: var(--space-4) var(--space-7);
		padding: var(--space-6) var(--space-3);
		text-decoration: none;
		transition:
			background-color var(--dur-base) var(--ease-out),
			padding-inline var(--dur-base) var(--ease-out);
	}

	.projects a:hover {
		background: var(--surface);
		padding-inline: var(--space-5) var(--space-3);
	}

	.projects h3 {
		font-size: 1.15rem;
	}

	.projects a:hover h3 {
		color: var(--accent);
	}

	.projects p {
		color: var(--muted);
		font-size: 0.945rem;
		max-width: 52ch;
	}

	.tags {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
		list-style: none;
		margin: 0;
		padding: 0;
		justify-content: flex-end;
	}

	.tag {
		font-size: 0.72rem;
		color: var(--accent);
		background: var(--accent-soft);
		border-radius: var(--radius-sm);
		padding: 0.25rem 0.5rem;
		white-space: nowrap;
	}

	@media (max-width: 900px) {
		.projects a {
			grid-template-columns: 1fr;
			gap: var(--space-2);
			padding-block: var(--space-5);
		}

		.tags {
			justify-content: flex-start;
			margin-top: var(--space-2);
		}

		.projects a:hover {
			padding-inline: var(--space-3);
		}
	}
</style>
