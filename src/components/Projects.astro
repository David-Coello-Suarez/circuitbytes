---
import { projects } from "../data/projects";
---

<section id="proyectos">
	<div class="wrap">
		<div class="head">
			<span class="mono">Proyectos</span>
			<h2>Trabajo reciente</h2>
			<p>Una muestra de lo que hemos construido en los últimos años.</p>
		</div>

		<div class="grid-3">
			{
				projects.map((project) => (
					<a class="proj" href={project.href}>
						<div class="thumb" aria-hidden="true">
							<span class="glow" />
						</div>
						<div class="proj-body">
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							<div class="tags">
								{project.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.proj {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		text-decoration: none;
		display: block;
		transition: 0.2s;
	}

	.proj:hover {
		transform: translateY(-4px);
		border-color: rgba(34, 211, 238, 0.45);
	}

	/* marcador visual mientras no haya imágenes reales de cada proyecto */
	.thumb {
		aspect-ratio: 16 / 10;
		position: relative;
		background: linear-gradient(135deg, #151a24, #0e1117);
		border-bottom: 1px solid var(--border);
	}

	.thumb::after {
		content: "";
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--border) 1px, transparent 1px),
			linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 26px 26px;
		opacity: 0.55;
	}

	.glow {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 130px;
		height: 130px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(34, 211, 238, 0.2), transparent 65%);
	}

	.proj-body {
		padding: 22px;
	}

	.proj-body h3 {
		font-size: 1.02rem;
		margin-bottom: 8px;
	}

	.proj-body p {
		font-size: 0.89rem;
		color: var(--muted);
	}

	.tags {
		display: flex;
		gap: 7px;
		flex-wrap: wrap;
		margin-top: 16px;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--accent);
		background: rgba(34, 211, 238, 0.09);
		border-radius: 5px;
		padding: 4px 8px;
	}

	@media (prefers-reduced-motion: reduce) {
		.proj:hover {
			transform: none;
		}
	}
</style>
