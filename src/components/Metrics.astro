---
import { metrics } from "../data/site";
---

<section class="metrics" aria-label="Cifras del estudio">
	<div class="wrap">
		<dl>
			{
				metrics.map((metric) => (
					<div>
						<dt>{metric.label}</dt>
						<dd class="tabular">{metric.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.metrics {
		padding-block: var(--space-7);
	}

	dl {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-6);
		border-top: 1px solid var(--border-strong);
		border-bottom: 1px solid var(--border-strong);
		padding-block: var(--space-6);
	}

	/* la etiqueta manda y el número la respalda: dato, no adorno */
	dt {
		font-size: 0.85rem;
		color: var(--muted);
		margin-bottom: var(--space-2);
	}

	dd {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.032em;
		line-height: 1;
	}

	@media (max-width: 760px) {
		dl {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-5);
		}
	}
</style>
