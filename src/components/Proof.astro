---
import { proof } from "../data/profile";
---

<section class="proof" aria-label="Resultados en cifras">
	<div class="wrap">
		<dl>
			{
				proof.map((item, index) => (
					<div>
						<dt class="tabular">{item.value}</dt>
						<dd>{item.label}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.proof {
		padding-block: 2.5rem;
	}

	dl {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
		border-block: 1px solid var(--color-line-strong);
		padding-block: 2rem;
	}

	/* la cifra y su contexto pesan parecido: es un dato, no un cartel */
	dt {
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.2;
	}

	dd {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
		color: var(--color-ink-muted);
		max-width: 26ch;
	}

	@media (max-width: 860px) {
		dl {
			grid-template-columns: 1fr 1fr;
			gap: 1.75rem;
		}
	}
</style>
