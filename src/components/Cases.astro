---
import { cases } from "../data/cases";

/** El color de la etiqueta distingue el estado real del trabajo. */
const statusTone: Record<string, string> = {
	"Propuesta desarrollada": "tag-sand",
	"Proyecto de integración": "tag-blue",
	"Experiencia técnica": "tag-plain",
};
---

<section id="casos">
	<div class="wrap">
		<div class="section-head">
			<h2>Casos y experiencia técnica</h2>
			<p>
				Cada trabajo aparece con su estado real. Lo que es una propuesta se
				presenta como propuesta, no como proyecto entregado.
			</p>
		</div>

		<ol class="cases">
			{
				cases.map((item) => (
					<li class="rise">
						<div class="head">
							<span class:list={["tag", statusTone[item.status]]}>
								{item.status}
							</span>
							<h3>{item.title}</h3>
							<p class="client">{item.client}</p>
						</div>

						<div class="detail">
							<p>{item.summary}</p>
							<ul class="outcomes">
								{item.outcomes.map((outcome) => (
									<li>{outcome}</li>
								))}
							</ul>
							<ul class="tags">
								{item.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	section {
		padding-block: 5rem;
	}

	.cases {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-rule);
	}

	.cases > li {
		display: grid;
		grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
		gap: 1.5rem 4rem;
		align-items: start;
		padding-block: 2.25rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.head .tag {
		margin-bottom: 0.75rem;
	}

	h3 {
		font-size: 1.1rem;
		margin: 0 0 0.25rem;
	}

	.client {
		font-size: 0.875rem;
		color: var(--color-ink-soft);
		margin: 0;
	}

	.detail > p {
		margin: 0;
		color: var(--color-ink);
		font-size: 0.9375rem;
		max-width: 62ch;
	}

	.outcomes {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.375rem;
	}

	.outcomes li {
		font-size: 0.9rem;
		color: var(--color-ink-soft);
		padding-left: 1rem;
		position: relative;
	}

	.outcomes li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 5px;
		height: 1px;
		background: var(--color-ink-soft);
	}

	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 1.25rem 0 0;
		padding: 0;
	}

	.tags li {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--color-ink-soft);
		border: 1px solid var(--color-rule);
		border-radius: var(--radius-xs);
		padding: 0.15rem 0.45rem;
	}

	@media (max-width: 900px) {
		.cases > li {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
