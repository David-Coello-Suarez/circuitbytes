---
import { stack } from "../data/site";
---

<div class="stack">
	<h3 class="mono">Stack</h3>
	<ul class="chips">
		{stack.map((tech) => <li class="chip">{tech}</li>)}
	</ul>
</div>

<style>
	.stack {
		margin-top: 44px;
	}

	.stack h3 {
		font-weight: 400;
		margin-bottom: 20px;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.chip {
		font-family: var(--font-mono);
		font-size: 0.79rem;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 7px;
		padding: 8px 14px;
		background: var(--surface);
	}
</style>
