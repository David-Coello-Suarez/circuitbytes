---
import { Icon } from "astro-icon/components";
import { services } from "../data/services";
---

<section id="servicios">
	<div class="wrap">
		<div class="head">
			<h2>Todo lo que necesitas para llevar una idea a producción</h2>
			<p>
				Nos hacemos cargo del ciclo completo: análisis, diseño, desarrollo,
				despliegue y soporte.
			</p>
		</div>

		<ul class="services">
			{
				services.map((service) => (
					<li>
						<Icon name={service.icon} aria-hidden="true" />
						<h3>{service.title}</h3>
						<p>{service.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* separadas por línea y espacio, no encajonadas en tarjetas iguales */
	.services {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: var(--space-8);
	}

	.services li {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: start;
		gap: var(--space-2) var(--space-4);
		padding-block: var(--space-6);
		border-top: 1px solid var(--border);
	}

	/* la línea superior de las dos primeras es la que abre el bloque */
	.services li:nth-child(-n + 2) {
		border-top-color: var(--border-strong);
	}

	.services [data-icon] {
		grid-row: span 2;
		width: 22px;
		height: 22px;
		color: var(--accent);
		margin-top: 0.15em;
	}

	.services h3 {
		font-size: 1.1rem;
	}

	.services p {
		color: var(--muted);
		font-size: 0.945rem;
		max-width: 44ch;
	}

	@media (max-width: 820px) {
		.services {
			grid-template-columns: 1fr;
		}

		.services li:nth-child(2) {
			border-top-color: var(--border);
		}
	}
</style>
