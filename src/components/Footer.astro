---
import { profile } from "../data/profile";

const year = new Date().getFullYear();

const legal = [
	{ label: "Aviso legal", href: "/aviso-legal" },
	{ label: "Privacidad", href: "/privacidad" },
	{ label: "Cookies", href: "/cookies" },
];
---

<footer>
	<div class="wrap grid">
		<p class="name">{profile.fullName}</p>

		<nav aria-label="Legal">
			<ul>
				{legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
			</ul>
		</nav>

		<nav aria-label="Perfiles profesionales">
			<ul>
				<li><a href={profile.linkedin}>LinkedIn</a></li>
				<li><a href={profile.github}>GitHub</a></li>
			</ul>
		</nav>

		<p class="copy">&copy; {year}. Todos los derechos reservados.</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--color-line);
		padding-block: 2.5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: space-between;
		align-items: center;
		gap: 1.25rem 2rem;
		font-size: 0.85rem;
		color: var(--color-ink-muted);
	}

	.name {
		margin: 0;
		color: var(--color-ink);
		font-weight: 500;
	}

	.copy {
		margin: 0;
	}

	nav ul {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		text-decoration: none;
		transition: color 180ms var(--ease-out);
	}

	nav a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
			justify-content: start;
		}
	}
</style>
