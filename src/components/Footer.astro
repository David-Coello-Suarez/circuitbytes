---
import { company } from "../data/company";

const year = new Date().getFullYear();

const legal = [
	{ label: "Aviso legal", href: "/aviso-legal" },
	{ label: "Privacidad", href: "/privacidad" },
	{ label: "Cookies", href: "/cookies" },
];
---

<footer>
	<div class="wrap grid">
		<div class="brand">
			<img class="mark" src="/logo-circuitbyte.png" alt="" width="122" height="88" />
			<div>
				<p class="name">{company.legalName}</p>
				<p class="tagline">{company.tagline}</p>
			</div>
		</div>

		<nav aria-label="Legal">
			<ul>
				{legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
			</ul>
		</nav>

		<nav aria-label="Redes">
			<ul>
				{/* TODO: enlaces reales de redes sociales */}
				<li><a href={company.linkedin}>LinkedIn</a></li>
				<li><a href={company.whatsapp}>WhatsApp</a></li>
			</ul>
		</nav>

		<div class="meta">
			{/* legalName ya termina en punto, no se añade otro */}
			<p>&copy; {year} {company.legalName} {company.country}.</p>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--color-rule);
		background: var(--color-canvas-warm);
		padding-block: 2.5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: space-between;
		gap: 2rem;
		align-items: start;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.mark {
		width: auto;
		height: 1.75rem;
		flex-shrink: 0;
	}

	.name {
		margin: 0;
		font-weight: 600;
		font-size: 0.9375rem;
		color: var(--color-ink-strong);
	}

	.tagline {
		margin: 0;
		font-size: 0.8rem;
		color: var(--color-ink-soft);
	}

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}

	nav a {
		font-size: 0.85rem;
		color: var(--color-ink-soft);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--color-ink-strong);
	}

	.meta p {
		margin: 0;
		font-size: 0.8rem;
		color: var(--color-ink-soft);
	}

	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr 1fr;
			justify-content: start;
		}
	}

	@media (max-width: 520px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
