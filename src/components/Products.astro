---
import { productCategories, productPromises } from "../data/products";
---

<section id="productos">
	<div class="wrap">
		<div class="section-head">
			<p class="tag tag-green">Línea 2 · Productos</p>
			<h2>Tecnología de última generación, con asesoría incluida</h2>
			<p>
				Te ayudamos a elegir el equipo según el uso real y nos encargamos de la
				configuración si lo necesitas.
			</p>
		</div>

		<ul class="catalog">
			{
				productCategories.map((category) => (
					<li class="card card-hover rise">
						{category.image ? (
							<img
								src={category.image}
								alt=""
								width="800"
								height="600"
								loading="lazy"
							/>
						) : (
							<div class="frame" role="presentation">
								<span>Fotografía pendiente</span>
							</div>
						)}
						<div class="body">
							<h3>{category.name}</h3>
							<p>{category.description}</p>
							<ul class="items">
								{category.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
							<a class="quote" href="#contacto">
								Cotizar esta categoría
							</a>
						</div>
					</li>
				))
			}
		</ul>

		<div class="promises">
			<ul>
				{productPromises.map((item) => <li>{item}</li>)}
			</ul>
			<a class="btn btn-secondary" href="#contacto">
				Solicitar lista de productos
			</a>
		</div>
	</div>
</section>

<style>
	section {
		padding-block: 5rem;
		background: var(--color-canvas-warm);
		border-block: 1px solid var(--color-rule);
	}

	.section-head .tag {
		margin-bottom: 1.25rem;
	}

	.catalog {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.catalog > li {
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.catalog img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-bottom: 1px solid var(--color-rule);
		/* la fotografía se integra en el monocromo en vez de gritar */
		filter: saturate(0.75) contrast(0.96);
	}

	/* marco declarado mientras no haya foto real del catálogo */
	.frame {
		aspect-ratio: 4 / 3;
		display: grid;
		place-items: center;
		border-bottom: 1px solid var(--color-rule);
		background-color: var(--color-canvas-warm);
		background-image: repeating-linear-gradient(
			45deg,
			transparent,
			transparent 7px,
			rgb(0 0 0 / 0.022) 7px,
			rgb(0 0 0 / 0.022) 14px
		);
	}

	.frame span {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: var(--color-ink-soft);
		background: var(--color-surface);
		border: 1px solid var(--color-rule);
		border-radius: var(--radius-xs);
		padding: 0.25rem 0.6rem;
	}

	.body {
		padding: 1.5rem;
		display: grid;
		align-content: start;
		gap: 0.625rem;
		flex: 1;
	}

	.body h3 {
		font-size: 1.05rem;
		margin: 0;
	}

	.body > p {
		color: var(--color-ink-soft);
		font-size: 0.9375rem;
		margin: 0;
	}

	.items {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.items li {
		font-size: 0.75rem;
		color: var(--color-ink-soft);
		border: 1px solid var(--color-rule);
		border-radius: var(--radius-xs);
		padding: 0.15rem 0.45rem;
	}

	.quote {
		margin-top: auto;
		padding-top: 1rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-soft-green-ink);
		text-decoration: none;
	}

	.quote:hover {
		text-decoration: underline;
	}

	.promises {
		margin-top: 2.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-rule);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 2rem;
	}

	.promises ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem 2rem;
	}

	.promises li {
		font-size: 0.9rem;
		color: var(--color-ink-soft);
		padding-left: 1rem;
		position: relative;
	}

	.promises li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 5px;
		height: 1px;
		background: var(--color-soft-green-ink);
	}

	@media (max-width: 900px) {
		.catalog {
			grid-template-columns: 1fr;
		}

		.promises {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.promises ul {
			grid-template-columns: 1fr;
		}
	}
</style>
