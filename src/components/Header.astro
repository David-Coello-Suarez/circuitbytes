---
import { company, nav } from "../data/company";
---

<header>
	<div class="wrap bar">
		<a class="brand" href="#top">
			{/* TODO: sustituir por el logotipo definitivo de CircuitByte. */}
			<span class="mark" aria-hidden="true"></span>
			<span class="name">
				{company.name}
				<span class="legal">S.A.S.</span>
			</span>
		</a>

		<nav id="menu" aria-label="Principal">
			<ul>
				{nav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			</ul>
		</nav>

		<a class="btn btn-primary cta" href="#contacto">Cotiza tu proyecto</a>

		<button
			class="burger"
			type="button"
			aria-expanded="false"
			aria-controls="menu"
			aria-label="Abrir menú"
		>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>
	</div>
</header>

<script>
	const header = document.querySelector("header");
	const burger = document.querySelector<HTMLButtonElement>(".burger");
	const menu = document.querySelector<HTMLElement>("#menu");

	if (header && burger && menu) {
		const setOpen = (open: boolean) => {
			header.classList.toggle("is-open", open);
			burger.setAttribute("aria-expanded", String(open));
			burger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
		};

		burger.addEventListener("click", () =>
			setOpen(burger.getAttribute("aria-expanded") !== "true"),
		);

		menu.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) setOpen(false);
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && header.classList.contains("is-open")) {
				setOpen(false);
				burger.focus();
			}
		});
	}
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--color-canvas) 82%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-rule);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 4.25rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		text-decoration: none;
	}

	.mark {
		width: 1.5rem;
		height: 1.5rem;
		flex-shrink: 0;
		border-radius: var(--radius-xs);
		background: var(--color-ink-strong);
	}

	.name {
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--color-ink-strong);
	}

	.legal {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 400;
		color: var(--color-ink-soft);
		margin-left: 0.15rem;
		letter-spacing: 0;
	}

	nav ul {
		display: flex;
		gap: 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		font-size: 0.9rem;
		color: var(--color-ink-soft);
		text-decoration: none;
		transition: color 180ms var(--ease-out);
	}

	nav a:hover {
		color: var(--color-ink-strong);
	}

	.burger {
		display: none;
		position: relative;
		width: 2.625rem;
		height: 2.625rem;
		padding: 0;
		background: var(--color-surface);
		border: 1px solid var(--color-rule);
		border-radius: var(--radius-xs);
		cursor: pointer;
	}

	.burger span {
		position: absolute;
		left: 50%;
		width: 1.0625rem;
		height: 1.5px;
		background: var(--color-ink-strong);
		transform: translateX(-50%);
		transition: 220ms var(--ease-out);
	}

	.burger span:first-child {
		top: 1rem;
	}

	.burger span:last-child {
		bottom: 1rem;
	}

	:global(header.is-open) .burger span:first-child {
		top: 50%;
		transform: translate(-50%, -50%) rotate(45deg);
	}

	:global(header.is-open) .burger span:last-child {
		bottom: 50%;
		transform: translate(-50%, 50%) rotate(-45deg);
	}

	@media (max-width: 940px) {
		.cta {
			display: none;
		}

		.burger {
			display: block;
		}

		/* panel opaco: detrás hay texto grande que se transparentaría */
		nav {
			position: absolute;
			left: 0;
			right: 0;
			top: 100%;
			background: var(--color-canvas);
			border-bottom: 1px solid var(--color-rule);
			display: grid;
			grid-template-rows: 0fr;
			visibility: hidden;
			transition:
				grid-template-rows 250ms var(--ease-out),
				visibility 250ms;
		}

		:global(header.is-open) nav {
			grid-template-rows: 1fr;
			visibility: visible;
		}

		nav ul {
			flex-direction: column;
			gap: 0;
			overflow: hidden;
			padding-inline: 1.5rem;
		}

		nav li + li {
			border-top: 1px solid var(--color-rule);
		}

		nav a {
			display: block;
			padding: 1rem 0;
			font-size: 1rem;
		}
	}
</style>
