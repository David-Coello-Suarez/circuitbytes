---
import { site } from "../data/site";
---

<section class="hero" id="top">
	<div class="wrap">
		<h1 class="enter enter-1">
			Tu operación merece <em>software propio</em>, no parches.
		</h1>

		<div class="foot">
			<p class="lead enter enter-2">
				Construimos las aplicaciones web, móviles y de escritorio que tu empresa
				necesita, con plazos cerrados y el código en tu poder.
			</p>

			<div class="actions enter enter-3">
				<div class="cta">
					<a class="btn btn-primary" href="#contacto">Agendar reunión</a>
					<a class="btn btn-ghost" href="#proyectos">Ver proyectos</a>
				</div>

				{
					site.available && (
						<p class="status">
							<span class="pulse" aria-hidden="true" />
							Agenda abierta. {site.responseTime}.
						</p>
					)
				}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-10) var(--space-8);
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: "";
		position: absolute;
		top: -220px;
		right: -160px;
		width: 680px;
		height: 680px;
		border-radius: var(--radius-pill);
		background: radial-gradient(circle, rgba(34, 211, 238, 0.13), transparent 62%);
		pointer-events: none;
	}

	.hero .wrap {
		position: relative;
		z-index: 1;
	}

	/* el titular a plena potencia: es el ancla de la página, no el acompañante
	   de un asset. Tope medido para que cierre en 2 líneas a todo el ancho. */
	h1 {
		font-size: clamp(2.35rem, 6.4vw, 4.5rem);
		max-width: 19ch;
		margin-bottom: var(--space-8);
	}

	h1 em {
		font-style: normal;
		color: var(--accent);
	}

	/* mismo filete que estructura servicios y proyectos */
	.foot {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: var(--space-6) var(--space-8);
		padding-top: var(--space-6);
		border-top: 1px solid var(--border-strong);
	}

	.lead {
		color: var(--muted);
		font-size: 1.075rem;
		max-width: 44ch;
	}

	.actions {
		display: grid;
		justify-items: start;
		gap: var(--space-4);
	}

	.cta {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	.status {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 0.85rem;
		color: var(--muted);
	}

	.pulse {
		width: 7px;
		height: 7px;
		border-radius: var(--radius-pill);
		background: var(--ok);
		flex-shrink: 0;
	}

	@media (max-width: 900px) {
		.hero {
			padding-block: var(--space-9) var(--space-7);
		}

		h1 {
			margin-bottom: var(--space-6);
		}

		.foot {
			grid-template-columns: 1fr;
			align-items: start;
		}
	}
</style>
