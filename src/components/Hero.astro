---
import { company, heroTech } from "../data/company";
---

<section class="hero" id="top">
	<div class="wrap">
		<h1 class="hero-in">
			Software a medida con IA y tecnología de última generación para tu
			empresa.
		</h1>

		<div class="foot">
			<p class="lead hero-in hero-in-2">
				Desarrollamos, integramos y modernizamos tus sistemas. Del front-end a
				la integración con tu ERP, con despliegue, seguridad y mantenimiento
				incluidos.
			</p>

			<div class="cta hero-in hero-in-3">
				<a class="btn btn-primary" href="#contacto">Cotiza tu proyecto</a>
				<a class="btn btn-secondary" href="#productos">Ver productos</a>
			</div>
		</div>

		<ul class="tech hero-in hero-in-4" aria-label="Tecnologías que utilizamos">
			{heroTech.map((item) => <li class="tag tag-plain">{item}</li>)}
		</ul>
	</div>
</section>

<style>
	.hero {
		padding-block: 6rem 4rem;
		/* luz difusa, no gradiente decorativo: da profundidad sin romper el plano */
		background:
			radial-gradient(
				60rem 32rem at 82% -8%,
				rgb(31 108 159 / 0.05),
				transparent 70%
			),
			var(--color-canvas);
	}

	h1 {
		font-size: clamp(2.4rem, 6vw, 4.25rem);
		max-width: 18ch;
		margin: 0 0 3rem;
	}

	.foot {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 2rem 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-rule);
	}

	.lead {
		font-size: 1.0625rem;
		color: var(--color-ink-soft);
		max-width: 52ch;
		margin: 0;
	}

	.cta {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 0;
	}

	@media (max-width: 860px) {
		.hero {
			padding-block: 3.5rem 3rem;
		}

		h1 {
			margin-bottom: 2rem;
		}

		.foot {
			grid-template-columns: 1fr;
			align-items: start;
		}
	}
</style>
