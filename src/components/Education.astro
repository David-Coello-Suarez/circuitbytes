---
import { certifications, formalEducation, languages } from "../data/education";
---

<section id="educacion">
	<div class="wrap">
		<div class="head">
			<h2>Formación y certificaciones</h2>
		</div>

		<div class="columns">
			<div>
				<h3>Formación</h3>
				<ul class="creds">
					{
						formalEducation.map((item) => (
							<li>
								<p class="title">{item.title}</p>
								<p class="meta">
									{item.issuer}
									<span class="year tabular">{item.year}</span>
								</p>
							</li>
						))
					}
				</ul>

				<h3 class="spaced">Idiomas</h3>
				<ul class="plain">
					{languages.map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<div>
				<h3>Certificaciones</h3>
				<ul class="creds">
					{
						certifications.map((item) => (
							<li>
								<p class="title">{item.title}</p>
								<p class="meta">
									{item.issuer}
									<span class="year tabular">{item.year}</span>
								</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	section {
		padding-block: 5rem;
	}

	.head {
		margin-bottom: 2.5rem;
	}

	.head h2 {
		font-size: clamp(1.75rem, 3.6vw, 2.4rem);
		margin: 0;
	}

	.columns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	h3 {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-ink-muted);
		margin: 0 0 1rem;
	}

	.spaced {
		margin-top: 2.5rem;
	}

	.creds {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-line);
	}

	.creds li {
		padding-block: 0.9rem;
		border-bottom: 1px solid var(--color-line);
	}

	.title {
		margin: 0;
		font-size: 0.95rem;
	}

	.meta {
		margin: 0.2rem 0 0;
		font-size: 0.82rem;
		color: var(--color-ink-muted);
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.plain {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.4rem;
	}

	.plain li {
		font-size: 0.9rem;
		color: var(--color-ink-muted);
	}

	@media (max-width: 760px) {
		.columns {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
