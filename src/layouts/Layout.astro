---
import { company } from "../data/company";
import Consent from "../components/Consent.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const { title = company.seoTitle, description = company.seoDescription } =
	Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": `${Astro.site}#organization`,
			name: company.legalName,
			alternateName: company.name,
			slogan: company.tagline,
			url: String(Astro.site),
			email: company.email,
			taxID: company.ruc,
			address: {
				"@type": "PostalAddress",
				addressCountry: "EC",
			},
		},
		{
			"@type": "LocalBusiness",
			"@id": `${Astro.site}#business`,
			name: company.legalName,
			description: company.seoDescription,
			url: String(Astro.site),
			email: company.email,
			telephone: company.phone,
			taxID: company.ruc,
			areaServed: company.country,
			address: {
				"@type": "PostalAddress",
				addressCountry: "EC",
			},
		},
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={company.legalName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="es_EC" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<meta name="theme-color" content="#fbfbfa" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(schema)}
		/>
	</head>
	<body>
		<a class="skip" href="#contenido">Saltar al contenido</a>
		<slot />
		<Consent />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 0.75rem;
		top: -4rem;
		z-index: 100;
		background: var(--color-ink-strong);
		color: var(--color-surface);
		padding: 0.625rem 1.125rem;
		border-radius: var(--radius-xs);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: top 180ms var(--ease-out);
	}

	.skip:focus-visible {
		top: 0.75rem;
	}
</style>
