---
import { profile } from "../data/profile";
import ConsentBanner from "../components/ConsentBanner.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const { title = profile.seoTitle, description = profile.seoDescription } =
	Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={profile.fullName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="es_EC" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<meta name="theme-color" content="#0b0d12" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

	</head>
	<body>
		<a class="skip" href="#contenido">Saltar al contenido</a>
		<slot />
		<ConsentBanner />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 0.75rem;
		top: -4rem;
		z-index: 100;
		background: var(--color-accent);
		color: var(--color-accent-ink);
		padding: 0.625rem 1.125rem;
		border-radius: var(--radius-md);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: top 180ms var(--ease-out);
	}

	.skip:focus-visible {
		top: 0.75rem;
	}
</style>
